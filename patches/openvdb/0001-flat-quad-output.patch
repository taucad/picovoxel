+// Flat-mode uniform polygon pipeline (see VolumeToMesh::enableFlatQuadOutput).
+// Pass 1: per-leaf quad upper bound = the same edge count ComputePolygons uses
+// to size each PolygonPool. Pass 2: emission through FlatUniformPrimBuilder
+// into per-leaf slot ranges of one shared array — the loop body mirrors
+// ComputePolygons::operator() exactly, so per-leaf emission order (and thus
+// final output order after compaction) is unchanged.
+
+template<typename TreeType>
+struct CountUniformQuadBounds
+{
+    using Int16TreeType = typename TreeType::template ValueConverter<Int16>::Type;
+    using Int16LeafNodeType = typename Int16TreeType::LeafNodeType;
+
+    CountUniformQuadBounds(
+        const std::vector<Int16LeafNodeType*>& signFlagsLeafNodes,
+        size_t * const upperBounds)
+        : mSignFlagsLeafNodes(signFlagsLeafNodes.data())
+        , mUpperBounds(upperBounds)
+    {
+    }
+
+    void operator()(const tbb::blocked_range<size_t>& range) const
+    {
+        for (size_t n = range.begin(); n != range.end(); ++n) {
+            size_t edgeCount = 0;
+            typename Int16LeafNodeType::ValueOnCIter iter =
+                mSignFlagsLeafNodes[n]->cbeginValueOn();
+            for (; iter; ++iter) {
+                if (iter.getValue() & XEDGE) ++edgeCount;
+                if (iter.getValue() & YEDGE) ++edgeCount;
+                if (iter.getValue() & ZEDGE) ++edgeCount;
+            }
+            mUpperBounds[n] = edgeCount;
+        }
+    }
+
+private:
+    Int16LeafNodeType * const * const mSignFlagsLeafNodes;
+    size_t              * const       mUpperBounds;
+}; // struct CountUniformQuadBounds
