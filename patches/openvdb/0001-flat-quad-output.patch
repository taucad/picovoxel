+// UniformPrimBuilder writing into a caller-provided slot range of one shared
+// flat array instead of a per-leaf PolygonPool — no per-leaf allocations, no
+// trim. Same addPrim semantics (including the reverse swizzle); flags are
+// dropped (the uniform path only produces them under reference meshing, which
+// the flat mode excludes).
+struct FlatUniformPrimBuilder
+{
+    FlatUniformPrimBuilder(): mIdx(0), mQuads(nullptr) {}
+
+    void init(const size_t /*upperBound*/, Vec4I* slotBase)
+    {
+        mQuads = slotBase;
+        mIdx = 0;
+    }
+
+    template<typename IndexType>
+    void addPrim(const math::Vec4<IndexType>& verts, bool reverse, char /*flags*/ = 0)
+    {
+        if (!reverse) {
+            mQuads[mIdx] = verts;
+        } else {
+            Vec4I& quad = mQuads[mIdx];
+            quad[0] = verts[3];
+            quad[1] = verts[2];
+            quad[2] = verts[1];
+            quad[3] = verts[0];
+        }
+        ++mIdx;
+    }
+
+    size_t done() { return mIdx; }
+
+private:
+    size_t mIdx;
+    Vec4I* mQuads;
+};
