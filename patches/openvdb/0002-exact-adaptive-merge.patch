+template<typename InputTreeAccessor, typename Index32TreeAccessor,
+    typename Int16LeafNodeType, typename Index32LeafNodeType, typename BoolLeafNodeType>
+inline bool
+exactFastMergeLeaf(ExactMergeScratch& S,
+    InputTreeAccessor& inputAcc,
+    Index32TreeAccessor& pointIndexAcc,
+    const Int16LeafNodeType& signFlagsNode,
+    Index32LeafNodeType& pointIndexNode,
+    const BoolLeafNodeType* maskLeaf,
+    const float iso,
+    const float adaptivity,
+    const bool invertGradientDir)
