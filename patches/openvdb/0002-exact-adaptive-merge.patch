+    std::memset(bad, 0, sizeof(bad));
+    std::memset(edges, 0, sizeof(edges));
+    std::memset(xEdge, 0, sizeof(xEdge));
+    std::memset(yEdge, 0, sizeof(yEdge));
+    std::memset(zEdge, 0, sizeof(zEdge));
