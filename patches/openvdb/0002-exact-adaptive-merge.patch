+// Exact fast path for MergeVoxelRegions (float grids, uniform adaptivity per leaf).
+//
+// It makes the same merge decisions, assigns the same region ids and writes the same
+// point-index values as the generic loop in MergeVoxelRegions::operator(), so the
+// mesh is byte-identical. What changes is how the decisions are computed:
+//  - One dense 10^3 copy of the input (the leaf plus a one-voxel apron, read once
+//    from the leaf and its neighbours) serves every manifold test and gradient,
+//    instead of 27 accessor reads per isNonManifold() call and 6 per gradient.
+//  - Inside/outside signs and point-index activity are kept as bit rows along z, so
+//    the 64 dimension-2 manifold tests and the missing-neighbour-point mask run four
+//    or eight voxels per integer operation.
+//  - The dimension-2 isNonManifold() result of the pre-pass is reused by the merge
+//    loop, which upstream evaluates a second time on the same input.
+//  - isMergeable() fails iff some pair (i, j) has (1.0 - dot) > adaptivity. That
+//    expression is monotone in the float dot, so the test is equivalent to
+//    dot < T for the smallest float T that passes (computed exactly below). Pairs
+//    are visited once (dot is symmetric), and pairs inside a child block that has
+//    already merged are skipped: a 4- or 8-block is only tested when all of its
+//    children merged, with the same threshold, so those pairs already passed.
+//  - Before the pair loop, a block of at least 12 normals, all unit length, passes
+//    when they lie within angle t of their sum and cos(2t) >= T + 1e-5. A normal
+//    that normalize() scaled has |n| = 1 +- 4e-7, so every pair's real dot is then
+//    >= T + 1e-5 - 2.1e-6, and its float dot (three products, two sums, error at
+//    most 3u|n_i||n_j| < 1.8e-7) is >= T: the generic loop passes too. The cone
+//    angle is bounded from the double-precision cosines minus 2e-6. When the cone
+//    test is inconclusive the exact pair loop decides.
+// Leaves whose gradients are not finite fall back to the generic code.
+
+struct ExactMergeScratch
+{
+    float v[1000];           // input values, local (-1..8)^3, index ((x+1)*10 + y+1)*10 + z+1
+    float nx[512], ny[512], nz[512]; // normals grouped by 2x2x2 block, see exactMergeGroup()
+    int start[65];           // normals of group g are [start[g], start[g+1])
+    float threshold = 0.0f;  // T for thresholdFor
+    float thresholdFor = -1.0f;
+};
+
+/// Group index of the 2x2x2 block holding local voxel (x, y, z): the 4x4x4 block in the
+/// high three bits, the 2-block within it in the low three, so each 4-block's children
+/// are contiguous.
+inline int exactMergeGroup(int x, int y, int z)
+{
+    return ((((x >> 2) << 2) | ((y >> 2) << 1) | (z >> 2)) << 3)
+        | (((x >> 1) & 1) << 2) | (((y >> 1) & 1) << 1) | ((z >> 1) & 1);
+}
+
+/// Smallest float T with !((1.0 - double(T)) > double(adaptivity)), for finite adaptivity.
+inline float exactMergeThreshold(float adaptivity)
+{
+    const auto passes = [adaptivity](float d) { return !((1.0 - double(d)) > double(adaptivity)); };
+    float t = float(1.0 - double(adaptivity));
+    if (passes(t)) {
+        for (;;) {
+            const float p = std::nextafter(t, -std::numeric_limits<float>::infinity());
+            if (!passes(p)) break;
+            t = p;
+        }
+    } else {
+        do { t = std::nextafter(t, std::numeric_limits<float>::infinity()); } while (!passes(t));
+    }
+    return t;
+}
+
+/// True when every pair (i, j), i in [b, e), j in [jb, je), has dot >= T.
+inline bool exactMergeRowsPass(const ExactMergeScratch& S, int b, int e, int jb, int je, float T)
+{
+    const float* const X = S.nx;
+    const float* const Y = S.ny;
+    const float* const Z = S.nz;
+    for (int i = b; i < e; ++i) {
+        const float xi = X[i], yi = Y[i], zi = Z[i];
+        int bad = 0;
+        for (int j = jb; j < je; ++j) {
+            const float d = xi * X[j] + yi * Y[j] + zi * Z[j];
+            bad |= int(d < T);
+        }
+        if (bad) return false;
+    }
+    return true;
+}
+
+/// Cone test over unit normals [b, e): true only if every pair's float dot is >= T
+/// (sufficient, not necessary).
+inline bool exactMergeConeAccepts(const ExactMergeScratch& S, int b, int e, float T)
+{
+    double mx = 0.0, my = 0.0, mz = 0.0;
+    for (int i = b; i < e; ++i) { mx += S.nx[i]; my += S.ny[i]; mz += S.nz[i]; }
+    const double ml = std::sqrt(mx * mx + my * my + mz * mz);
+    if (!(ml > 1e-3)) return false;
+    double cmin = 2.0 * ml;
+    for (int i = b; i < e; ++i) {
+        const double c = double(S.nx[i]) * mx + double(S.ny[i]) * my + double(S.nz[i]) * mz;
+        cmin = std::min(cmin, c);
+    }
+    const double c = cmin / ml - 2e-6;
+    if (!(c > 0.0)) return false;
+    return 2.0 * c * c - 1.0 >= double(T) + 1e-5;
+}
+
+/// Exact test of the pairs of block [S.start[g0], S.start[g0 + 8 * stride]) that cross its
+/// eight children, each child being stride consecutive groups.
+inline bool exactMergeCrossPass(const ExactMergeScratch& S, int g0, int stride, bool unit, float T)
+{
+    const int b = S.start[g0], e = S.start[g0 + 8 * stride];
+    if (e - b < 2) return true;
+    if (unit && e - b >= 12 && exactMergeConeAccepts(S, b, e, T)) return true;
+    for (int c = 0; c < 7; ++c) {
+        const int cb = S.start[g0 + c * stride], ce = S.start[g0 + (c + 1) * stride];
+        if (cb != ce && !exactMergeRowsPass(S, cb, ce, ce, e, T)) return false;
+    }
+    return true;
+}
+
+/// 64-bit group mask of the 2x2x2 blocks that hold at least one voxel of the rows
+/// rows[x][y] (bit z).
+inline uint64_t exactMergeBlocksOf(const uint8_t rows[8][8])
+{
+    uint64_t out = 0;
+    for (int x = 0; x < 8; x += 2) {
+        for (int y = 0; y < 8; y += 2) {
+            unsigned r = unsigned(rows[x][y] | rows[x + 1][y] | rows[x][y + 1] | rows[x + 1][y + 1]);
+            r = (r | (r >> 1)) & 0x55u;
+            for (; r; r &= r - 1) {
+                const int z = int(util::FindLowestOn(uint32_t(r)));
+                out |= uint64_t(1) << exactMergeGroup(x, y, z);
+            }
+        }
+    }
+    return out;
+}
