+            const unsigned e = ambiguous ? 0u : bit;
+            bad[x][y] |= uint8_t(ambiguous ? bit : 0u);
+            edges[x][y] |= uint8_t((flags & EDGES) ? e : 0u);
+            xEdge[x][y] |= uint8_t((flags & XEDGE) ? e : 0u);
+            yEdge[x][y] |= uint8_t((flags & YEDGE) ? e : 0u);
+            zEdge[x][y] |= uint8_t((flags & ZEDGE) ? e : 0u);
