+++ b/Source/PicoGKMesh.h	2026-07-26 16:47:19
@@ -155,7 +155,38 @@
     {
         return m_oBBox;
     }
-    
+
+    // Bulk-construction seam: pre-size both arrays, let the caller fill
+    // disjoint slots in parallel through aVertexData()/aTriangleData(), then
+    // FinalizeBulk() restores the invariants nAddVertex/nAddTriangle maintain
+    // incrementally (bounding box and memory accounting). Intended for a
+    // freshly constructed Mesh; counts must not change after BulkResize.
+    inline void BulkResize( size_t nVertices,
+                            size_t nTriangles)
+    {
+        // Vector3 has no default constructor; fill-resize needs only the
+        // copy constructor and every slot is overwritten by the bulk writer.
+        m_oVertices.resize(nVertices, Vector3(0.0f, 0.0f, 0.0f));
+        m_oTriangles.resize(nTriangles);
+    }
+
+    inline Vector3* aVertexData()
+    {
+        return m_oVertices.data();
+    }
+
+    inline Triangle* aTriangleData()
+    {
+        return m_oTriangles.data();
+    }
+
+    inline void FinalizeBulk(const BBox3& oBBox)
+    {
+        m_oBBox.Include(oBBox);
+        m_nMemUsage =   (int64_t) (m_oVertices.size()  * sizeof(Vector3))
+                      + (int64_t) (m_oTriangles.size() * sizeof(Triangle));
+    }
+
 public:
     
     const std::vector<Vector3>& vVertices() const
