--- a/Source/PicoGKLibrary.cpp
+++ b/Source/PicoGKLibrary.cpp
@@ -230,6 +230,26 @@
     return roLib->m_oMeshes.hAdd(roVoxels->roAsMesh());
 }
 
+PICOGK_API PKMESH Mesh_hCreateFromVoxelsAdaptive(   PKINSTANCE hLib,
+                                                    PKVOXELS hVoxels,
+                                                    float fAdaptivity,
+                                                    bool bRelax)
+{
+    PKTRACE(Mesh_hCreateFromVoxelsAdaptive);
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+
+    // NaN and values at or below 0 select the uniform mesher. At 1 OpenVDB
+    // drops its normal test, so the range ends just below 1.
+    if (!(fAdaptivity > 0.0f))
+        fAdaptivity = 0.0f;
+    else if (fAdaptivity >= 1.0f)
+        fAdaptivity = std::nextafter(1.0f, 0.0f);
+
+    Voxels::Ptr roVoxels = roLib->m_oVoxels.roGet(hVoxels);
+    return roLib->m_oMeshes.hAdd(roVoxels->roAsMesh(fAdaptivity, bRelax));
+}
+
 PICOGK_API bool Mesh_bIsValid(  PKINSTANCE hLib,
                                 PKMESH hThis)
 {
