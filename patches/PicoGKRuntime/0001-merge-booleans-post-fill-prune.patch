+    /// [picovoxel U-SK05-a] Merge-based CSG.
+    ///
+    /// openvdb's csg{Union,Difference,Intersection} steal from their second
+    /// operand, so a const operand had to be deep-copied WHOLE before the call —
+    /// one full-grid materialization thrown away per boolean. The very same
+    /// merge operators take a DeepCopy tag instead (tools/Merge.h, TreeToMerge):
+    /// they copy only the nodes actually grafted and track consumption in a
+    /// lightweight mask tree, which is what the Steal path does by removing the
+    /// node from the source. Same operator, same traversal (DynamicNodeManager
+    /// top-down over A), same prune — so values and tree topology are identical;
+    /// only the eager copy is gone.
+    ///
+    /// The body is what csgUnion/csgIntersection/csgDifference do with
+    /// prune=true, pruneCancelledTiles=false (Composite.h) minus the steal.
+    template<class TCsgOp>
+    void CsgMergeFrom(const Voxels& oOther)
+    {
+        FloatTree&       oTree      = m_roGrid->tree();
+        const FloatTree& oOtherTree = oOther.m_roGrid->tree();
+
+        openvdb::tools::composite::validateLevelSet(oTree, "A");
+        openvdb::tools::composite::validateLevelSet(oOtherTree, "B");
 
+        TCsgOp oOp(oOtherTree, openvdb::DeepCopy());
+        openvdb::tree::DynamicNodeManager<FloatTree> oNodes(oTree);
+        oNodes.foreachTopDown(oOp);
+
+        openvdb::tools::pruneLevelSet(oTree);
+    }
