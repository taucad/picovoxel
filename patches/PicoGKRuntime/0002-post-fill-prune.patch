+    /// [picovoxel U-SK05-b] Collapse the dense leaves a per-voxel fill leaves behind.
+    ///
+    /// The fills that walk a dense accessor over a bounding box (RenderImplicit,
+    /// RenderLattice, ProjectZSlice*) allocate a leaf for every 8³ block they
+    /// touch, including the blocks that end up uniformly outside (+background)
+    /// or uniformly inside (−background). The csg paths already end in
+    /// pruneLevelSet (Composite.h, prune=true), so only these fills ship the
+    /// slack — and every downstream op then iterates it.
+    ///
+    /// Value-neutral: see PruneSignUniform. Measured on the fills above:
+    /// identical raw levelSetVolume, identical mesh-roundtrip volume,
+    /// identical STL bytes; 5.5% (lattice), 36% (ProjectZSlice) and 68%
+    /// (RenderImplicit) less tree.
+    void PruneFill()
+    {
+        PruneSignUniform(m_roGrid->tree());
+    }
+
+public:
+    /// [picovoxel U-SK05-b] openvdb::tools::pruneLevelSet, restricted to the
+    /// nodes it can collapse without changing a single value.
+    ///
+    /// pruneLevelSet replaces every node that holds no active value with a
+    /// ±background tile signed like the node's FIRST value. In a narrow-band
+    /// level set that is exact: a sign change always crosses active band
+    /// voxels, so an inactive node is uniformly inside or outside. A fill
+    /// clipped by its bounding box breaks that assumption. Where the box cuts
+    /// solid interior deeper than the band, −background voxels meet untouched
+    /// +background with no band between them, and pruneLevelSet flips the
+    /// whole node (and, bottom-up, its 128³ and 4096³ parents) to one sign.
+    ///
+    /// Here a node collapses only when it holds no active value AND every
+    /// value in it has one sign; a mixed-sign node stays as it is. Every
+    /// inactive voxel a fill writes is exactly ±background (SetSdValue clamps,
+    /// then turns off only |value| ≥ background), and the voxels it does not
+    /// write keep the level set's own ±background, so the tile carries the
+    /// value each voxel already had. Everywhere else this is pruneLevelSet:
+    /// same bottom-up pass, same tiles.
+    static void PruneSignUniform(FloatTree& oTree, bool bThreaded = true)
+    {
+        tree::NodeManager<FloatTree, FloatTree::DEPTH - 2> oNodes(oTree);
+        SignUniformPruneOp oOp(oTree);
+        oNodes.foreachBottomUp(oOp, bThreaded);
+    }
+
+protected:
+    /// The pruneLevelSet operator (tools/Prune.h LevelSetPruneOp) plus the
+    /// one-sign check.
+    struct SignUniformPruneOp
+    {
+        explicit SignUniformPruneOp(FloatTree& oTree)
+            : m_fOutside(oTree.background())
+            , m_fInside(math::negative(m_fOutside))
+        {
+            oTree.clearAllAccessors(); // cached nodes may be pruned
+        }
+
+        void operator()(FloatTree::LeafNodeType&) const {}
+
+        template<typename NodeT>
+        void operator()(NodeT& oNode) const
+        {
+            for (auto it = oNode.beginChildOn(); it; ++it)
+            {
+                bool bInside = false;
+                if (bCollapsible(*it, bInside))
+                    oNode.addTile(it.pos(), bInside ? m_fInside : m_fOutside, false);
+            }
+        }
+
+        void operator()(FloatTree::RootNodeType& oRoot) const
+        {
+            for (auto it = oRoot.beginChildOn(); it; ++it)
+            {
+                bool bInside = false;
+                if (bCollapsible(*it, bInside))
+                    oRoot.addTile(it.getCoord(), bInside ? m_fInside : m_fOutside, false);
+            }
+            oRoot.eraseBackgroundTiles();
+        }
+
+        /// No active value, and every value signed like the first. Children
+        /// are pruned first (bottom-up), so a node that still has a child
+        /// node is not inactive and never reaches the value scan.
+        template<typename ChildT>
+        static bool bCollapsible(const ChildT& oChild, bool& bInside)
+        {
+            if (!oChild.isInactive())
+                return false;
+
+            bInside = math::isNegative(oChild.getFirstValue());
+            for (auto it = oChild.cbeginValueAll(); it; ++it)
+            {
+                if (math::isNegative(*it) != bInside)
+                    return false;
+            }
+            return true;
+        }
+
+        const float m_fOutside;
+        const float m_fInside;
+    };
+
