+
+// Bulk mesh transfer.
+//
+// Vertices and triangles already live in contiguous std::vectors of 12-byte
+// #pragma pack(1) types that are layout-identical to PKVector3 / PKTriangle, so
+// reads are one std::copy. (Vector3 has a user-provided copy constructor, so
+// std::copy and not memcpy — clang lowers it to the same vectorised move at -O3.)
+//
+// Writes route through nAddVertex / nAddTriangle per element so the bounding box
+// and the memory bookkeeping stay correct; the win was never the loop, it was not
+// crossing the ABI once per element.
+
+PICOGK_API int32_t Mesh_GetVertices(    PKINSTANCE hLib,
+                                        PKMESH hThis,
+                                        PKVector3* pvecBuffer,
+                                        int32_t nBufferCount)
+{
+    if (pvecBuffer == nullptr || nBufferCount <= 0)
+        return 0;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    const std::vector<Vector3>& oVertices
+        = roLib->m_oMeshes.roGet(hThis)->vVertices();
+
+    const int32_t nCount = std::min(   nBufferCount,
+                                        (int32_t) oVertices.size());
+
+    std::copy(oVertices.begin(), oVertices.begin() + nCount, pvecBuffer);
+    return nCount;
 }
 
+PICOGK_API int32_t Mesh_GetTriangles(   PKINSTANCE hLib,
+                                        PKMESH hThis,
+                                        PKTriangle* psBuffer,
+                                        int32_t nBufferCount)
+{
+    if (psBuffer == nullptr || nBufferCount <= 0)
+        return 0;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    const std::vector<Triangle>& oTriangles
+        = roLib->m_oMeshes.roGet(hThis)->vTriangles();
+
+    const int32_t nCount = std::min(   nBufferCount,
+                                        (int32_t) oTriangles.size());
+
+    std::copy(oTriangles.begin(), oTriangles.begin() + nCount, psBuffer);
+    return nCount;
+}
+
+PICOGK_API int32_t Mesh_AddVertices(    PKINSTANCE hLib,
+                                        PKMESH hThis,
+                                        const PKVector3* pvecBuffer,
+                                        int32_t nCount)
+{
+    if (pvecBuffer == nullptr || nCount <= 0)
+        return -1;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    Mesh::Ptr roMesh = roLib->m_oMeshes.roGet(hThis);
+
+    const int32_t nFirst = roMesh->nAddVertex(pvecBuffer[0]);
+
+    for (int32_t n = 1; n < nCount; n++)
+        roMesh->nAddVertex(pvecBuffer[n]);
+
+    return nFirst;
+}
+
+PICOGK_API int32_t Mesh_AddTriangles(   PKINSTANCE hLib,
+                                        PKMESH hThis,
+                                        const PKTriangle* psBuffer,
+                                        int32_t nCount)
+{
+    if (psBuffer == nullptr || nCount <= 0)
+        return -1;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    Mesh::Ptr roMesh = roLib->m_oMeshes.roGet(hThis);
+
+    const int32_t nFirst = roMesh->nAddTriangle(psBuffer[0]);
+
+    for (int32_t n = 1; n < nCount; n++)
+        roMesh->nAddTriangle(psBuffer[n]);
+
+    return nFirst;
+}
