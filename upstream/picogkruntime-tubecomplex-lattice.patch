@@ -48,6 +48,10 @@
 #include <openvdb/tools/LevelSetSphere.h>
 #include <openvdb/tools/LevelSetTubes.h>
 #include <openvdb/tools/LevelSetDilatedMesh.h>
+#include <openvdb/tools/Prune.h>
+
+#include <tbb/blocked_range.h>
+#include <tbb/parallel_reduce.h>
 
 #include "PicoGKMesh.h"
 #include "PicoGKTrace.h"
@@ -343,7 +347,31 @@
     void RenderLattice(const Lattice& oLattice)
     {
         PKTRACE(Voxels_RenderLattice);
+        
+        // [picovoxel U5] The parallel lane. Every sphere, and every round-capped beam,
+        // is exactly the convex hull of two spheres -- which is what openvdb's tube
+        // complex voxelizes: a scanline walk over only the voxels each shape actually
+        // touches, spread across every core, instead of one thread taking one accessor
+        // over every element's padded bounding box in turn.
+        //
+        // bRenderLatticeTubes() returns false when the lane does not apply -- nothing
+        // sphere-capped in the lattice, or a grid whose narrow band the complex cannot
+        // reproduce bit-for-bit -- and has then written NOTHING, so the loops below still
+        // render the whole lattice. Otherwise it has rendered everything except the flat
+        // cones, and hands those back as a lattice of their own. That lattice has no
+        // spheres and no round caps, so the recursive call takes the false branch and the
+        // recursion ends exactly one level down.
         
+        Lattice oFlatCapped;
+        
+        if (bRenderLatticeTubes(oLattice, &oFlatCapped))
+        {
+            if (!oFlatCapped.oBeams().empty())
+                RenderLattice(oFlatCapped);
+            
+            return;
+        }
+        
         auto oAccess = m_roGrid->getAccessor();
         
         for (auto roSphere : oLattice.oSpheres())
@@ -825,7 +853,192 @@
             SetSdValue(poAccess, xyz, fBackground, fValue);
         }
     }
+    
+    /// [picovoxel U5] Upstream stores beams as std::vector<LatticeBeam::Ptr>; with the
+    /// U18 value-storage change applied it is std::vector<LatticeBeam>. This renderer
+    /// does not care which, and these two overloads are the whole of not caring.
     
+    static const LatticeBeam& oBeamRef(const LatticeBeam& oBeam)        {return oBeam;}
+    
+    static const LatticeBeam& oBeamRef(const LatticeBeam::Ptr& roBeam)  {return *roBeam;}
+    
+    /// [picovoxel U5] Renders the sphere-capped part of a lattice -- every sphere and
+    /// every round-capped beam -- through openvdb's parallel tube-complex voxelizer, and
+    /// unions the result into this grid.
+    ///
+    /// Returns true when the complex was built and unioned in; *poFlatCapped then holds
+    /// exactly the beams this lane cannot express and the caller must still render those.
+    /// Returns false when the lane does not apply at all -- NOTHING has been written to
+    /// the grid in that case, and the caller must render the whole lattice itself.
+    ///
+    /// The case table, and why each case lands where it does:
+    ///
+    ///   round cap, r0 != r1    tapered capsule. fSdvRoundCone and openvdb's
+    ///                          TaperedCapsuleVoxelizer are both the exact SDF of the
+    ///                          convex hull of the two end spheres: same shape, same
+    ///                          definition.
+    ///   round cap, r0 == r1    capsule. openvdb dispatches this itself once
+    ///                          |r0-r1| < 0.001 voxel, avoiding the tapered form's
+    ///                          degenerate algebra; fSdvRoundCone handles it analytically.
+    ///                          Same shape.
+    ///   nested end spheres     the larger ball -- which IS the convex hull in that case.
+    ///                          ((p0-p1)^2 <= (r0-r1)^2.) Note fSdvRoundCone is WRONG
+    ///                          here: a2 = l^2 - (r0-r1)^2 goes negative and it takes
+    ///                          sqrtf of a negative product. Against the closed form the
+    ///                          serial lane renders -90.7% of the true volume and the tube
+    ///                          complex -0.37%, and only the complex is checkLevelSet
+    ///                          clean.
+    ///   zero-length round beam never arrives: Lattice::AddBeam turns it into a sphere.
+    ///   sphere                 a zero-length segment with equal end radii, which lands in
+    ///                          the same ball branch. Spheres therefore ride in the SAME
+    ///                          complex as the beams; there is no second pass.
+    ///   FLAT cap               no tube-complex expression. fSdvFlatCone is a conical
+    ///                          frustum with planar ends, and the complex is built
+    ///                          exclusively from sphere-capped convex hulls -- there is no
+    ///                          open/flat variant in the API. Handed back to the caller.
+    bool bRenderLatticeTubes(   const Lattice&  oLattice,
+                                Lattice*        poFlatCapped)
+    {
+        // The complex builds its own grid, so that grid's voxel size AND background have
+        // to match this one bit-for-bit, or the csgUnion below would splice two different
+        // narrow bands together. Both are the same float product -- PicoGK spells the
+        // background nNarrowBand * m_fVoxelSizeMM (VoxelSize::fToMM), openvdb spells it
+        // voxelSize * halfWidth in double and rounds once (Grid.h createLevelSet) -- and
+        // for float operands those agree exactly, because a float x float product is
+        // always exact in double. VERIFY it rather than assume it: m_nSdfNarrowBand is an
+        // int32 a caller can desynchronize from the grid it describes (IntersectImplicit
+        // hands fBackgroundMM() straight to the int narrow-band constructor), so a grid
+        // whose band is not an integer number of voxels is reachable. Such a grid goes
+        // down the serial lane, unchanged.
+        const float fVoxelSize = (float) m_roGrid->voxelSize().x();
+        const float fHalfWidth = (float) m_nSdfNarrowBand;
+        
+        if (    (fVoxelSize <= 0.0f)
+            ||  (fHalfWidth < 1.0f)
+            ||  (fVoxelSize * fHalfWidth != m_roGrid->background()))
+        {
+            return false;
+        }
+        
+        std::vector<openvdb::Vec3s> oVertices;
+        std::vector<openvdb::Vec2I> oSegments;
+        std::vector<float>          oRadii;
+        
+        const size_t nSpheres   = oLattice.oSpheres().size();
+        const size_t nBeams     = oLattice.oBeams().size();
+        
+        oVertices.reserve(  nSpheres + 2 * nBeams);
+        oRadii.reserve(     nSpheres + 2 * nBeams);
+        oSegments.reserve(  nSpheres + nBeams);
+        
+        // A sphere is a zero-length segment with equal end radii: the per-vertex-radii
+        // dispatch sends (p1-p2)^2 <= (r1-r2)^2 to its ball branch, which is that sphere.
+        // Reusing the one vertex for both segment ends keeps the radius array in step.
+        for (const LatticeSphere::Ptr& roSphere : oLattice.oSpheres())
+        {
+            const Vector3& vecCenter = roSphere->vecCenter();
+            const openvdb::Index32 nAt = (openvdb::Index32) oVertices.size();
+            
+            oVertices.push_back(openvdb::Vec3s( vecCenter.X,
+                                                vecCenter.Y,
+                                                vecCenter.Z));
+            
+            oRadii.push_back(roSphere->fRadius());
+            oSegments.push_back(openvdb::Vec2I(nAt, nAt));
+        }
+        
+        for (const auto& oEntry : oLattice.oBeams())
+        {
+            const LatticeBeam& oBeam = oBeamRef(oEntry);
+            
+            if (!oBeam.bRoundCap())
+            {
+                // Re-authored as a lattice of its own, so the serial lane can render
+                // exactly these beams and nothing else. AddBeam is given
+                // bRoundCap = false, so its zero-length-beam-becomes-a-sphere rule
+                // cannot fire and the subset stays a subset.
+                poFlatCapped->AddBeam(  oBeam.vecStart(),
+                                        oBeam.vecEnd(),
+                                        oBeam.fRadStart(),
+                                        oBeam.fRadEnd(),
+                                        false);
+                
+                continue;
+            }
+            
+            const Vector3& vecStart = oBeam.vecStart();
+            const Vector3& vecEnd   = oBeam.vecEnd();
+            const openvdb::Index32 nAt = (openvdb::Index32) oVertices.size();
+            
+            oVertices.push_back(openvdb::Vec3s( vecStart.X,
+                                                vecStart.Y,
+                                                vecStart.Z));
+            
+            oVertices.push_back(openvdb::Vec3s( vecEnd.X,
+                                                vecEnd.Y,
+                                                vecEnd.Z));
+            
+            oRadii.push_back(oBeam.fRadStart());
+            oRadii.push_back(oBeam.fRadEnd());
+            oSegments.push_back(openvdb::Vec2I(nAt, nAt + 1));
+        }
+        
+        if (oSegments.empty())
+            return false; // nothing this lane can express -- the caller renders it all
+        
+        // Per-VERTEX radii: a PicoGK beam tapers between its two endpoint radii, which is
+        // openvdb's TUBE_VERTEX_RADII policy -- a complex of tapered capsules.
+        typedef openvdb::tools::lvlset::TubeComplexVoxelizer<
+                    openvdb::FloatGrid,
+                    float,
+                    openvdb::util::NullInterrupter,
+                    /* PerSegmentRadii = */ false>          TubeVoxelizer;
+        
+        TubeVoxelizer oOp(  oVertices,
+                            oSegments,
+                            oRadii,
+                            fVoxelSize,
+                            fHalfWidth,
+                            nullptr);
+        
+        // Determinism by construction, not by luck. tools::createLevelSetTubeComplex
+        // drives this same voxelizer under tbb::parallel_reduce with the auto partitioner,
+        // so the number of body splits -- and hence the shape of the csg join tree --
+        // depends on how many workers turn up. csg union is a min, and min is exactly
+        // associative and commutative in IEEE, so the VALUES are order-free either way;
+        // the resulting tree TOPOLOGY is not, and a 1-thread and a 12-thread run would not
+        // even take the same split tree. parallel_deterministic_reduce with a grain size
+        // derived only from the bucket count makes the split tree a pure function of the
+        // input -- identical at 1 thread and at 12. Measured bit-exact single == multi on
+        // every fixture tried, at no cost.
+        //
+        // nSplitTarget is the number of leaf tasks that split tree is cut into. Only its
+        // being a CONSTANT is load-bearing for determinism; 16 was chosen by sweeping
+        // 16/32/64 at 12 threads -- it wins the beam-count-heavy stages and keeps every
+        // core fed without paying for a deeper join tree.
+        const size_t nBuckets = (size_t) oOp.bucketSize();
+        
+        if (nBuckets > 0)
+        {
+            const size_t nSplitTarget   = 16;
+            const size_t nGrain         = nBuckets <= nSplitTarget
+                                            ? 1
+                                            : (nBuckets + nSplitTarget - 1) / nSplitTarget;
+            
+            tbb::parallel_deterministic_reduce(
+                tbb::blocked_range<size_t>(0, nBuckets, nGrain), oOp);
+        }
+        
+        FloatGrid::Ptr roTubes = oOp.getGrid();
+        openvdb::tools::pruneLevelSet(roTubes->tree());
+        
+        // Boolean-add into the target, exactly as RenderMesh does. csgUnion prunes on
+        // exit, which is the pruning the serial dense fill never does.
+        openvdb::tools::csgUnion(*m_roGrid, *roTubes);
+        
+        return true;
+    }
+    
     static FloatGrid::Ptr roFloatGridFromMesh(  const Mesh& oMesh,
                                                 VoxelSize oVoxelSize,
                                                 int32_t nHalfWidth)
