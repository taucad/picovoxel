--- a/Source/PicoGKLibrary.cpp
+++ b/Source/PicoGKLibrary.cpp
@@ -392,6 +392,60 @@
                     fRadiusA,
                     fRadiusB,
                     bRoundCap);
+}
+
+// Bulk lattice authoring -- the import mirror of the bulk mesh entry points.
+//
+// Lattice_AddBeam is a per-element ABI crossing, and a lattice is authored in
+// the hundreds of thousands of beams. Elements still route through
+// Lattice::AddBeam / AddSphere so the bounding box and the degenerate round-cap
+// rule (a zero-length round-capped beam becomes a sphere) are unchanged; the win
+// is not the loop, it is not crossing the ABI once per beam.
+
+PICOGK_API int32_t Lattice_AddBeams( PKINSTANCE hLib,
+                                     PKLATTICE hThis,
+                                     const float* pfBeams,
+                                     const uint32_t* pnRoundCap,
+                                     int32_t nCount)
+{
+    if (pfBeams == nullptr || pnRoundCap == nullptr || nCount <= 0)
+        return 0;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    Lattice::Ptr roLattice = roLib->m_oLattices.roGet(hThis);
+
+    for (int32_t n = 0; n < nCount; n++)
+    {
+        const float* pf = pfBeams + n * 8;
+
+        roLattice->AddBeam( Vector3(pf[0], pf[1], pf[2]),
+                            Vector3(pf[4], pf[5], pf[6]),
+                            pf[3],
+                            pf[7],
+                            pnRoundCap[n] != 0);
+    }
+
+    return nCount;
+}
+
+PICOGK_API int32_t Lattice_AddSpheres(  PKINSTANCE hLib,
+                                        PKLATTICE hThis,
+                                        const float* pfSpheres,
+                                        int32_t nCount)
+{
+    if (pfSpheres == nullptr || nCount <= 0)
+        return 0;
+
+    Library::Instance::Ptr roLib = Library::oLib().roGetInstance(hLib);
+    Lattice::Ptr roLattice = roLib->m_oLattices.roGet(hThis);
+
+    for (int32_t n = 0; n < nCount; n++)
+    {
+        const float* pf = pfSpheres + n * 4;
+        roLattice->AddSphere(Vector3(pf[0], pf[1], pf[2]), pf[3]);
+    }
+
+    return nCount;
 }
 
 PICOGK_API PKVOXELS Voxels_hCreate(PKINSTANCE hLib)
