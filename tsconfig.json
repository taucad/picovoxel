{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023", "dom", "esnext.disposable"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "demo",
    "examples",
    "spikes",
    "tsdown.config.ts",
    "tsdown.gate.config.ts",
    "tsdown.demo.config.ts",
    "tsdown.webgpu.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/pico.mjs", "src/pico-multi.mjs", "node_modules", "dist", "build", "vendor"]
}
