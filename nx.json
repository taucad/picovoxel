{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "runtime"],
    "runtime": [
      { "runtime": "node --version" },
      { "runtime": "pnpm --version" },
      { "runtime": "command -v emcc >/dev/null 2>&1 && emcc --version | head -n1 || echo emcc-absent" }
    ]
  },
  "analytics": false,
  "release": {
    "projects": ["picovoxel"],
    "projectsRelationship": "fixed",
    "version": {
      "specifierSource": "version-plans",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        "**/*.test.*",
        "AGENTS.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "MAINTAINER.md",
        "SECURITY.md",
        ".agents/**",
        ".claude/**",
        ".github/ISSUE_TEMPLATE/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/actions/download-verified-artifact/**",
        ".github/actions/setup/**",
        ".github/dependabot.yml",
        ".github/workflows/**",
        "bench/**",
        "demo/**",
        "docs/**",
        "docs-site/**",
        "examples/**",
        "spikes/**",
        "test/**",
        "tests/**",
        "upstream/**",
        ".oxfmtrc.json",
        ".oxlintrc.json",
        ".shellcheckrc",
        ".vale.ini",
        ".vale/**",
        "DEPS.json",
        "eslint.config.mjs",
        "knip.json",
        "osv-scanner.toml",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tools/**",
        "vitest.config.ts",
        "scripts/candidate-manifest.mjs",
        "scripts/check-prose.sh",
        "scripts/check-workflows.sh",
        "scripts/coverage-*",
        "scripts/ci-release.mjs",
        "scripts/extract-candidate-packages.mjs",
        "scripts/install-ci-tool.sh",
        "scripts/plan-check.mjs",
        "scripts/prepare-release.mjs",
        "scripts/registry-wait.mjs",
        "scripts/test-bundler.mjs",
        "scripts/test-package.mjs",
        "scripts/verify-preview-install.mjs",
        "scripts/verify-release-attestations.mjs"
      ]
    },
    "changelog": {
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": { "pattern": "v{version}" },
    "git": {
      "commit": false,
      "push": false,
      "stageChanges": false,
      "tag": false
    }
  }
}
