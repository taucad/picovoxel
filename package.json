{
  "name": "picovoxel",
  "version": "0.1.0",
  "type": "module",
  "description": "PicoGK — voxel/implicit computational geometry on OpenVDB — compiled to WebAssembly, with an idiomatic TypeScript API",
  "license": "Apache-2.0",
  "keywords": [
    "picogk",
    "openvdb",
    "voxel",
    "implicit",
    "sdf",
    "cad",
    "geometry",
    "webassembly",
    "wasm"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./multi": {
      "types": "./dist/multi.d.ts",
      "import": "./dist/multi.js"
    },
    "./latticelibrary": {
      "types": "./dist/latticelibrary.d.ts",
      "import": "./dist/latticelibrary.js"
    },
    "./numerics": {
      "types": "./dist/numerics.d.ts",
      "import": "./dist/numerics.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    },
    "./shapekernel": {
      "types": "./dist/shapekernel.d.ts",
      "import": "./dist/shapekernel.js"
    },
    "./slicing": {
      "types": "./dist/slicing.d.ts",
      "import": "./dist/slicing.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "files": [
    "dist",
    "MIGRATING-FROM-CSHARP.md",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/dispose.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "test:unit": "vitest run --exclude 'test/examples-*.test.ts' --exclude test/g0-gate.test.ts",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-gate.mjs",
    "bench": "node bench/run.mjs",
    "build:demo": "tsdown --config tsdown.demo.config.ts",
    "build:emdawnwebgpu-spike": "bash scripts/build-emdawnwebgpu-spike.sh",
    "build:node-webgpu-spike": "bash scripts/build-node-webgpu-spike.sh",
    "build:webgpu-picovoxel-spike": "bash scripts/build-webgpu-picovoxel-spike.sh",
    "build:webgpu-cpu-probe": "bash scripts/build-webgpu-cpu-probe.sh",
    "build:webgpu-spike": "tsdown --config tsdown.webgpu.config.ts",
    "spike:emdawnwebgpu": "node scripts/emdawnwebgpu-spike.mjs",
    "spike:node-webgpu": "node scripts/node-webgpu-spike.mjs",
    "spike:webgpu": "node scripts/webgpu-spike.mjs"
  },
  "peerDependencies": {
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "pkg-pr-new": "0.0.88",
    "playwright": "^1.61.1",
    "three": "^0.185.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/picovoxel.git"
  },
  "homepage": "https://github.com/taucad/picovoxel#readme",
  "bugs": {
    "url": "https://github.com/taucad/picovoxel/issues"
  }
}
