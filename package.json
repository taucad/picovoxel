{
  "name": "picovoxel",
  "version": "0.0.0",
  "description": "PicoGK voxel and implicit geometry on OpenVDB, compiled to WebAssembly with a typed TypeScript API.",
  "keywords": [
    "cad",
    "geometry",
    "implicit",
    "openvdb",
    "picogk",
    "sdf",
    "voxel",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://tau.new",
  "bugs": {
    "url": "https://github.com/taucad/picovoxel/issues"
  },
  "license": "Apache-2.0",
  "author": "Richard Fontein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taucad/picovoxel.git"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATING-FROM-CSHARP.md",
    "compatibility.md",
    "CHANGELOG.md",
    "BREAKING_CHANGES.md",
    "NOTICE",
    "license"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/dispose.js"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./multi": {
      "import": {
        "types": "./dist/multi.d.ts",
        "default": "./dist/multi.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/multi.d.ts",
        "default": "./dist/multi.js"
      }
    },
    "./latticelibrary": {
      "import": {
        "types": "./dist/latticelibrary.d.ts",
        "default": "./dist/latticelibrary.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/latticelibrary.d.ts",
        "default": "./dist/latticelibrary.js"
      }
    },
    "./numerics": {
      "import": {
        "types": "./dist/numerics.d.ts",
        "default": "./dist/numerics.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/numerics.d.ts",
        "default": "./dist/numerics.js"
      }
    },
    "./raw": {
      "import": {
        "types": "./dist/raw.d.ts",
        "default": "./dist/raw.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/raw.d.ts",
        "default": "./dist/raw.js"
      }
    },
    "./shapekernel": {
      "import": {
        "types": "./dist/shapekernel.d.ts",
        "default": "./dist/shapekernel.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/shapekernel.d.ts",
        "default": "./dist/shapekernel.js"
      }
    },
    "./slicing": {
      "import": {
        "types": "./dist/slicing.d.ts",
        "default": "./dist/slicing.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/slicing.d.ts",
        "default": "./dist/slicing.js"
      }
    },
    "./three": {
      "import": {
        "types": "./dist/three.d.ts",
        "default": "./dist/three.js"
      },
      "require": {
        "types": "./dist/cjs-error.d.cts",
        "default": "./dist/cjs-error.cjs"
      },
      "default": {
        "types": "./dist/three.d.ts",
        "default": "./dist/three.js"
      }
    },
    "./wasm": "./dist/pico.wasm",
    "./glue": "./dist/pico.mjs",
    "./multi/wasm": "./dist/pico-multi.wasm",
    "./multi/worker": "./dist/pico-multi.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "test:unit": "vitest run --exclude 'test/examples-*.test.ts' --exclude test/g0-gate.test.ts",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-gate.mjs",
    "test:scripts": "node --test tests/*.test.mjs",
    "test:package": "node scripts/test-package.mjs candidate",
    "check": "nx run picovoxel:quality",
    "check:size": "size-limit",
    "check:dead-code": "knip",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --type-aware && eslint .",
    "pkgcheck": "pnpm run validate-pack && node scripts/pkgcheck.mjs",
    "plan:check": "nx release plan:check",
    "prose": "./scripts/check-prose.sh",
    "validate-pack": "node scripts/validate-pack.mjs",
    "workflows": "./scripts/check-workflows.sh",
    "prepublishOnly": "node scripts/validate-pack.mjs",
    "bench": "node bench/run.mjs",
    "build:demo": "tsdown --config tsdown.demo.config.ts",
    "build:emdawnwebgpu-spike": "bash scripts/build-emdawnwebgpu-spike.sh",
    "build:node-webgpu-spike": "bash scripts/build-node-webgpu-spike.sh",
    "build:webgpu-picovoxel-spike": "bash scripts/build-webgpu-picovoxel-spike.sh",
    "build:webgpu-cpu-probe": "bash scripts/build-webgpu-cpu-probe.sh",
    "build:webgpu-spike": "tsdown --config tsdown.webgpu.config.ts",
    "spike:emdawnwebgpu": "node scripts/emdawnwebgpu-spike.mjs",
    "spike:node-webgpu": "node scripts/node-webgpu-spike.mjs",
    "spike:webgpu": "node scripts/webgpu-spike.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.32.0",
    "@nx/js": "23.1.1",
    "@size-limit/file": "13.0.3",
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.32.0",
    "globals": "17.11.0",
    "knip": "6.17.1",
    "nx": "23.1.1",
    "oxfmt": "0.36.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.22.1",
    "pkg-pr-new": "0.0.88",
    "playwright": "1.61.1",
    "publint": "0.3.23",
    "size-limit": "13.0.3",
    "three": "0.185.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.7.0"
}
