<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Net=11 builds on .NET 11, whose workload pins Emscripten 6.0.2 (build.sh NET=11). -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(Net)' == '11'">net11.0</TargetFramework>
    <!-- .NET 11 keeps Mono as the browser runtime but no longer infers it, self-contained
         or trimming, for a plain Microsoft.NET.Sdk project. -->
    <UseMonoRuntime Condition="'$(Net)' == '11'">true</UseMonoRuntime>
    <SelfContained Condition="'$(Net)' == '11'">true</SelfContained>
    <PublishTrimmed Condition="'$(Net)' == '11'">true</PublishTrimmed>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS1591;CS8632;CS0162;CS0168;CS0219;CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmBuildNative>true</WasmBuildNative>
    <RunAOTCompilation Condition="'$(Aot)' != 'false'">true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <EmccMaximumHeapSize>4294967296</EmccMaximumHeapSize>
    <EmccStackSize>8388608</EmccStackSize>
  </PropertyGroup>
  <PropertyGroup>
    <PicoNative>$(MSBuildThisFileDirectory)native</PicoNative>
  </PropertyGroup>
  <!-- Threads=true: .NET's multithreaded runtime with the pthreads build of the PicoGK runtime
       (native-mt). Managed code then runs on a worker, so the task can block while oneTBB's
       workers run; the pthread pool is pre-spawned because the main thread cannot spawn
       workers while a parallel_for waits on it. -->
  <PropertyGroup Condition="'$(Threads)' == 'true'">
    <WasmEnableThreads>true</WasmEnableThreads>
    <_WasmPThreadPoolInitialSize>$(PoolSize)</_WasmPThreadPoolInitialSize>
    <_WasmPThreadPoolInitialSize Condition="'$(PoolSize)' == ''">8</_WasmPThreadPoolInitialSize>
    <PicoNative>$(MSBuildThisFileDirectory)native-mt</PicoNative>
    <!-- picovoxel's threaded artifact uses mimalloc: dlmalloc's one free-list lock serializes
         oneTBB's workers. Malloc=dlmalloc keeps Emscripten's default. -->
    <EmccExtraLDFlags Condition="'$(Malloc)' != 'dlmalloc'">$(EmccExtraLDFlags) -sMALLOC=mimalloc</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The unmodified PicoGK C# library (headless split) and LEAP 71 ShapeKernel. -->
    <Compile Include="picogk/**/*.cs" />
    <Compile Include="shapekernel/**/*.cs" />
    <Compile Include="examples/**/*.cs" />
    <!-- The web host: the platform shim (viewer, Library.Go) and the entry point. -->
    <Compile Include="host/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- PicoGK's own dependency; SkiaSharp ships a browser-wasm native asset. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The PicoGK runtime, statically linked into the same wasm module as the .NET runtime:
         every [DllImport("picogk.26.2")] becomes a direct wasm call. -->
    <NativeFileReference Include="$(PicoNative)/picogk.26.2.a" />
    <NativeFileReference Include="$(PicoNative)/libopenvdb.a" />
    <NativeFileReference Include="$(PicoNative)/libtbb.a" />
    <!-- Float trigonometry through the double functions, matching the native build's preload
         (libm/float-trig.c); an object file, so it wins over musl's sinf without a clash. -->
    <NativeFileReference Include="$(PicoNative)/float-trig.o" Condition="'$(FloatTrig)' != 'false'" />
  </ItemGroup>
</Project>
