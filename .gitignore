# Emscripten build output — generated by scripts/build-pico-module.sh (THREADS=1 for
# the pthread pair), never edited. CI builds both variants from pinned sources and
# the published binaries come from that run (close-out D3); src/pico*.mjs is the
# wasm glue and would otherwise look like hand-written source.
src/pico.mjs
src/pico.wasm
src/pico-multi.mjs
src/pico-multi.wasm
# The export names each built wasm carries (scripts/generate-wasm-exports.mjs, run
# by build-pico-module.sh): they belong to the untracked artifact they describe.
src/pico.exports.ts
src/pico-multi.exports.ts
