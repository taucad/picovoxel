<!-- Imported automatically by NuGet. Exposes the package's own payload by path and
     the identities it is pinned to. dotnet/tests/package.test.mjs holds these literals
     equal to dotnet/inputs.json, so they cannot drift from the qualified toolchain. -->
<Project>
  <PropertyGroup>
    <PicoVoxelPicoGKRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</PicoVoxelPicoGKRoot>
    <PicoVoxelPicoGKManifest>$(PicoVoxelPicoGKRoot)manifest.json</PicoVoxelPicoGKManifest>
    <PicoVoxelPicoGKBase>$(PicoVoxelPicoGKRoot)base/</PicoVoxelPicoGKBase>
    <PicoVoxelPicoGKBaseSource>$(PicoVoxelPicoGKBase)source/</PicoVoxelPicoGKBaseSource>
    <PicoVoxelPicoGKBaseProject>$(PicoVoxelPicoGKBase)PicoGK.csproj</PicoVoxelPicoGKBaseProject>
    <PicoVoxelPicoGKPatches>$(PicoVoxelPicoGKBase)patches/</PicoVoxelPicoGKPatches>
    <PicoVoxelPicoGKManagedSupplement>$(PicoVoxelPicoGKBase)managed/</PicoVoxelPicoGKManagedSupplement>
    <PicoVoxelPicoGKCompose>$(PicoVoxelPicoGKBase)compose.mjs</PicoVoxelPicoGKCompose>
    <PicoVoxelPicoGKGenerator>$(PicoVoxelPicoGKRoot)generator/PicoVoxel.Sdf.Generator.dll</PicoVoxelPicoGKGenerator>
    <PicoVoxelPicoGKRetentionProps>$(PicoVoxelPicoGKRoot)browser/AuthoringRetention.props</PicoVoxelPicoGKRetentionProps>
    <PicoVoxelPicoGKToolchain>$(PicoVoxelPicoGKRoot)toolchain/</PicoVoxelPicoGKToolchain>
    <PicoVoxelPicoGKRoslynRoot>$(PicoVoxelPicoGKRoot)roslyn/</PicoVoxelPicoGKRoslynRoot>
    <PicoVoxelPicoGKEngineSerial>$(PicoVoxelPicoGKRoot)engine/serial/</PicoVoxelPicoGKEngineSerial>
    <PicoVoxelPicoGKEngineThreaded>$(PicoVoxelPicoGKRoot)engine/threaded/</PicoVoxelPicoGKEngineThreaded>
  </PropertyGroup>
  <PropertyGroup>
    <PicoVoxelPicoGKSdk>11.0.100-rc.3.26522.148</PicoVoxelPicoGKSdk>
    <PicoVoxelPicoGKRuntime>11.0.0-rc.3.26522.148</PicoVoxelPicoGKRuntime>
    <PicoVoxelPicoGKEmscripten>6.0.3</PicoVoxelPicoGKEmscripten>
    <PicoVoxelPicoGKEmscriptenRevision>6ea9c28c38cdd40c1032fa04400c9d16230ee180</PicoVoxelPicoGKEmscriptenRevision>
    <PicoVoxelPicoGKRoslyn>5.9.0</PicoVoxelPicoGKRoslyn>
    <PicoVoxelPicoGKSkiaSharp>3.119.0</PicoVoxelPicoGKSkiaSharp>
    <PicoVoxelPicoGKReferences>$(NetCoreTargetingPackRoot)/packs/Microsoft.NETCore.App.Ref/$(PicoVoxelPicoGKRuntime)/ref/net11.0/</PicoVoxelPicoGKReferences>
  </PropertyGroup>
</Project>
