{
  // Generated, recorded or byte-locked files are never reformatted: the
  // generators and the tests compare their exact bytes.
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    "dist/**",
    "vendor/**",
    "pnpm-lock.yaml",
    // Emscripten glue, generated by scripts/build-pico-module.sh.
    "src/pico.mjs",
    "src/pico-multi.mjs",
    // Generator outputs that CI and test/generate-raw.test.ts diff byte for byte.
    "src/abi.json",
    "src/raw.generated.ts",
    // Byte-locked geometry pins and the frozen public-surface manifest.
    "test/fixtures/**",
    "test/surface-manifest.json",
    "spikes/webgpu/fixtures/**",
    // Recorded benchmark and native-comparison evidence.
    "bench/results/**",
    // The maintainer's working files; formatted by their owner, never by a sweep.
    "demo/main.ts",
    "examples/pico/modular-gyroid-puzzle.ts",
    "test/examples-pico.test.ts"
  ],
  "printWidth": 110,
  "singleQuote": true
}
