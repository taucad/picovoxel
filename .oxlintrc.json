{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    "dist/**",
    "vendor/**",
    // Emscripten glue, generated by scripts/build-pico-module.sh.
    "src/pico.mjs",
    "src/pico-multi.mjs"
  ],
  "plugins": ["typescript", "unicorn"],
  "rules": {
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }]
  }
}
